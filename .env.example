# ==============================================================================
# Grocycle Docker Compose Configuration (.env)
# ==============================================================================

# --- Host Path to Monitor ---
# Host directory to inspect for storage growth velocity.
# Mounted read-only (:ro) inside the container at CONTAINER_MONITOR_PATH.
# Examples:
#   HOST_MONITOR_PATH=/           (Monitor entire host filesystem root)
#   HOST_MONITOR_PATH=/var/log    (Monitor system logs)
#   HOST_MONITOR_PATH=/data       (Monitor specific mount/data directory)
HOST_MONITOR_PATH=/

# Target mount path inside container
CONTAINER_MONITOR_PATH=/monitored

# --- Grocycle Scanner Configuration ---
# Target roots to scan inside container (comma-separated if multiple)
GROCYCLE_MONITORED_ROOTS=/monitored

# Scan frequency: 10m to 30d (e.g. 15m, 1h, 6h, 24h, 7d) or raw seconds (default: 1h = 3600)
GROCYCLE_SCAN_INTERVAL=1h

# Path prefixes to skip during traversal (comma-separated)
GROCYCLE_EXCLUDED_PREFIXES=/proc,/sys,/dev,/run,/tmp,/var/tmp

# Rate limiting / Low-impact traversal settings:
# Directory batch count before yielding
GROCYCLE_THROTTLE_BATCH=250
# Sleep duration in milliseconds between batches
GROCYCLE_THROTTLE_SLEEP_MS=15

# --- Storage & IPC Paths ---
GROCYCLE_DB_PATH=/var/lib/grocycle/grocycle.db
GROCYCLE_SOCKET_PATH=/run/grocycle/grocycle.sock
GROCYCLE_LOG_FILE=/var/log/grocycle.log

# --- Web Terminal UI Configuration ---
# Host port exposed to the browser (http://localhost:8080)
WEB_PORT=8080

# Port listened by the web server inside the container
GROCYCLE_WEB_PORT=8080

# Optional HTTP Basic Authentication in "username:password" format.
# Leave empty to disable authentication.
GROCYCLE_WEB_AUTH=

# Maximum concurrent interactive browser terminal sessions (1 to 50)
GROCYCLE_WEB_MAX_CLIENTS=5
