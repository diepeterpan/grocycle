FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libsqlite3-dev \
    sqlite3 \
    pkg-config \
    clang-tidy \
    clang-format \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
